# Required. Keep blank until an approved target is known.
TEST_ENV=staging
BASE_URL=
ALLOW_UNRECOGNIZED_STAGING_HOST=false

# Backward-compatible URL alias. BASE_URL takes precedence.
STAGING_BASE_URL=

# Optional access-gate credentials. Never commit real values.
QA_ACCESS_COOKIE_NAMES=
QA_COOKIE_VALUE=

# Optional: publish each test's final failed attempt to Jam.
# Requires an authenticated Jam CLI session locally, or JAM_TOKEN in CI.
JAM_AUTO_CREATE=false
JAM_AUTO_CREATE_DRY_RUN=false
JAM_MAX_FAILURE_JAMS=5
JAM_FOLDER=gfxf
JAM_CLI_PATH=

VISUAL_THRESHOLD=0.1
VISUAL_MAX_DIFF_RATIO=0.01
PERF_FCP_MS=2500
PERF_LCP_MS=4000
PERF_CLS=0.1
PERF_LOAD_MS=5000

# Ecommerce flow routes
SIGNUP_PATH=/signup
LOGIN_PATH=/login
FORGOT_PASSWORD_PATH=/forgot-password
PRODUCT_LISTING_PATH=/products
PRODUCT_DETAIL_PATH=/products/sample-product
ADD_TO_CART_PATH=/products/sample-product
CHECKOUT_PATH=/checkout
PAYMENT_ERRORS_PATH=/checkout
ACCOUNT_DASHBOARD_PATH=/account
ORDER_HISTORY_PATH=/account/orders

# Signup validation safety controls
TEST_EMAIL_DOMAIN=example.test
ALLOW_NON_STAGING_ECOMMERCE_TESTS=false
ALLOW_SIGNUP_ACCOUNT_CREATION=false
ENABLE_TEST_INBOX=false
ENABLE_TEST_ACCOUNT_CLEANUP=false
EXISTING_TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_CLEANUP_ENDPOINT=

# Optional API route patterns used for mocking and response assertions
SIGNUP_API_PATTERN=**/*signup*
LOGIN_API_PATTERN=**/*login*
FORGOT_PASSWORD_API_PATTERN=**/*forgot*
CHECKOUT_API_PATTERN=**/*checkout*

# Optional verification-link test data
TEST_VERIFICATION_LINK=
TEST_EXPIRED_VERIFICATION_LINK=
TEST_INVALID_VERIFICATION_LINK=
