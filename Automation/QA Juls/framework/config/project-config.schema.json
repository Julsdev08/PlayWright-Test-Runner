{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reusable QA Agent Project Configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectName",
    "projectSlug",
    "testEnvironment",
    "websiteType",
    "testingScope",
    "includedPages",
    "excludedPages",
    "allowedDomains",
    "browserProjects",
    "authentication",
    "formsAllowedForSubmission",
    "actions",
    "productionSafety",
    "testData",
    "requiredTags",
    "reporting"
  ],
  "oneOf": [
    { "required": ["baseURL"] },
    { "required": ["baseUrlEnv"] }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectName": { "type": "string", "minLength": 1 },
    "projectSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "baseURL": { "type": "string", "format": "uri" },
    "baseUrlEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "testEnvironment": { "enum": ["local", "staging", "production"] },
    "websiteType": { "enum": ["marketing", "e-commerce", "web-application", "dashboard", "custom"] },
    "testingScope": { "type": "array", "items": { "type": "string" } },
    "includedPages": { "type": "array", "items": { "type": "string" } },
    "excludedPages": { "type": "array", "items": { "type": "string" } },
    "allowedDomains": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "browserProjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "device", "enabled"],
        "properties": {
          "name": { "type": "string" },
          "device": { "enum": ["desktop", "mobile"] },
          "enabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "authentication": {
      "type": "object",
      "required": ["required", "strategy", "credentialEnvVars", "approvedTestAccounts"],
      "properties": {
        "required": { "type": "boolean" },
        "strategy": { "enum": ["none", "credentials", "storage-state", "access-gate", "custom"] },
        "credentialEnvVars": { "type": "array", "items": { "type": "string" } },
        "approvedTestAccounts": { "type": "array", "items": { "type": "object" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "formsAllowedForSubmission": { "type": "array", "items": { "type": "string" } },
    "actions": {
      "type": "object",
      "required": ["allowed", "prohibited"],
      "properties": {
        "allowed": { "$ref": "#/$defs/actionList" },
        "prohibited": { "$ref": "#/$defs/actionList" }
      },
      "additionalProperties": false
    },
    "productionSafety": {
      "type": "object",
      "required": ["allowReadOnly", "allowWriteActions", "requireExplicitApprovalForWrites"],
      "properties": {
        "allowReadOnly": { "type": "boolean" },
        "allowWriteActions": { "type": "boolean" },
        "requireExplicitApprovalForWrites": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "testData": {
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": { "enum": ["json", "csv", "generated", "custom"] },
        "path": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "requiredTags": { "type": "array", "items": { "type": "string", "pattern": "^@" } },
    "reporting": {
      "type": "object",
      "required": ["outputDir", "formats"],
      "properties": {
        "outputDir": { "type": "string" },
        "formats": {
          "type": "array",
          "items": { "enum": ["html", "json", "markdown", "xlsx"] }
        },
        "excel": {
          "type": "object",
          "required": ["templatePath", "outputFile"],
          "properties": {
            "templatePath": { "type": "string" },
            "outputFile": { "type": "string" },
            "sheetName": { "type": "string" },
            "owner": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "actionList": {
      "type": "array",
      "items": {
        "enum": [
          "read-only",
          "data-creating",
          "notification-triggering",
          "destructive",
          "transaction-related",
          "file-upload"
        ]
      }
    }
  },
  "additionalProperties": false
}
