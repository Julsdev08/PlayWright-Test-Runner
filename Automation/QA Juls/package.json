{
  "name": "ai-qa-automation-framework",
  "version": "1.0.0",
  "description": "AI-ready QA automation framework using Playwright, TypeScript, Pixelmatch, and ExcelJS.",
  "private": true,
  "scripts": {
    "build": "tsc",
    "qa:onboard": "npm run build --silent && node dist/cli/qa-agent.js onboard",
    "qa:validate": "npm run build --silent && node dist/cli/qa-agent.js validate",
    "qa:plan": "npm run build --silent && node dist/cli/qa-agent.js plan",
    "qa:approval:status": "npm run build --silent && node dist/cli/qa-agent.js approval-status",
    "qa:setup:excel": "node scripts/setup-artifact-tool.mjs",
    "qa:report": "npm run qa:setup:excel --silent && npm run build --silent && node dist/cli/qa-agent.js report",
    "qa:verify:local": "npm run build --silent && node dist/cli/qa-agent.js verify-local",
    "jam:doctor": "node scripts/jam-cli.mjs doctor",
    "jam:auth:status": "node scripts/jam-cli.mjs auth status",
    "jam:webhook:test": "npm --prefix integrations/jam-webhook test",
    "test:jam": "JAM_AUTO_CREATE=true playwright test",
    "test:jam:dry-run": "JAM_AUTO_CREATE=true JAM_AUTO_CREATE_DRY_RUN=true playwright test",
    "test": "playwright test",
    "test:representative": "playwright test tests/smoke/registration.smoke.spec.ts tests/functional/signup-validation.spec.ts tests/regression/signup-critical.spec.ts tests/regression/signup-responsive.spec.ts",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:critical": "playwright test --grep @critical",
    "test:desktop": "playwright test --project=desktop-chromium --grep @desktop",
    "test:mobile": "playwright test --project=mobile-chromium --grep @mobile",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:signup": "playwright test tests/signup",
    "test:ecommerce-backlog": "playwright test tests/ecommerce-flows",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "faker": "^6.6.6",
    "lighthouse": "^13.4.0",
    "jszip": "^3.10.1",
    "pixelmatch": "^5.3.0",
    "playwright-lighthouse": "^4.0.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.5.0",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5"
  }
}
